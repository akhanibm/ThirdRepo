import "tfplan/v2" as tfplan

// Define required mandatory tags
param required_tags default ["Environment", "Owner", "Project"]

// --- RULE 1: CHECK FOR PUBLIC STORAGE BUCKETS ---
validate_no_public_buckets = func() {
	passed = true

	// 1. Check AWS S3 Public Access Block resources
	aws_s3_blocks = filter tfplan.resource_changes as _, rc {
		rc.type is "aws_s3_bucket_public_access_block" and
			(rc.change.actions contains "create" or rc.change.actions contains "update")
	}

	// Ensure every S3 bucket has a corresponding public access block enforcing restrictions
	for aws_s3_blocks as _, rc {
		block_public_acls = rc.change.after.block_public_acls else false
		ignore_public_acls = rc.change.after.ignore_public_acls else false
		block_public_policy = rc.change.after.block_public_policy else false
		restrict_public_buckets = rc.change.after.restrict_public_buckets else false

		if not (block_public_acls and ignore_public_acls and block_public_policy and restrict_public_buckets) {
			print("Violation: AWS S3 Bucket Public Access Block is not fully enabled for resource:", rc.address)
			passed = false
		}
	}

	// 2. Check Azure Storage Accounts for public blob access
	azurerm_accounts = filter tfplan.resource_changes as _, rc {
		rc.type is "azurerm_storage_account" and
			(rc.change.actions contains "create" or rc.change.actions contains "update")
	}

	for azurerm_accounts as _, rc {
		allow_nested_items_to_be_public = rc.change.after.allow_nested_items_to_be_public else true
		if allow_nested_items_to_be_public {
			print("Violation: Azure Storage Account allows public access:", rc.address)
			passed = false
		}
	}

	// 3. Check Google Cloud Storage buckets for public IAM members
	gcp_buckets = filter tfplan.resource_changes as _, rc {
		rc.type is "google_storage_bucket_iam_member" or rc.type is "google_storage_bucket_iam_binding" and
			(rc.change.actions contains "create" or rc.change.actions contains "update")
	}

	for gcp_buckets as _, rc {
		member = rc.change.after.member else (rc.change.after.members else [])
		// Check string member or list of members for public identifiers
		if member is "allUsers" or member is "allAuthenticatedUsers" {
			print("Violation: GCP Storage bucket grants public IAM access to:", rc.address)
			passed = false
		}
	}

	return passed
}

// --- RULE 2: CHECK FOR UNTAGGED RESOURCES ---
validate_resource_tags = func() {
	passed = true

	// Resources that support tags across common providers
	taggable_types = [
		"aws_instance", "aws_s3_bucket", "aws_vpc", "aws_subnet",
		"azurerm_resource_group", "azurerm_virtual_network",
		"google_compute_instance", "google_storage_bucket",
	]

	all_resources = filter tfplan.resource_changes as _, rc {
		rc.mode is "managed" and
			(rc.change.actions contains "create" or rc.change.actions contains "update")
	}

	for all_resources as _, rc {
		// Check if resource type matches a taggable category (or customize as needed)
		is_taggable = false
		for taggable_types as _, t {
			if rc.type is t {
				is_taggable = true
			}
		}

		if is_taggable {
			// Extract tags map safely
			resource_tags = rc.change.after.tags else (rc.change.after.labels else {})
			if resource_tags is null {
				resource_tags = {}
			}

			for required_tags as _, req_tag {
				if resource_tags[req_tag] is null {
					print("Violation: Resource", rc.address, "is missing required tag:", req_tag)
					passed = false
				}
			}
		}
	}

	return passed
}

// Main rule evaluations
public_buckets_allowed = validate_no_public_buckets()
tags_present = validate_resource_tags()

main = rule {
	public_buckets_allowed and tags_present
}